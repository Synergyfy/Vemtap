{
  "name": "@vemtap/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "dotenv -e .env -- nest start",
    "dev": "dotenv -e .env -- nest start --watch",
    "start:dev": "dotenv -e .env -- nest start --watch",
    "start:staging": "cross-env NODE_ENV=staging dotenv -e .env.staging -- nest start --watch",
    "start:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod -- node dist/main",
    "start:debug": "dotenv -e .env -- nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test ts-node scripts/create-test-db.ts && cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "seed": "dotenv -e .env -- ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:staging": "cross-env NODE_ENV=staging dotenv -e .env.staging -- ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod -- ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:admin-plans": "dotenv -e .env -- ts-node -r tsconfig-paths/register src/seed-admin-plans.ts",
    "seed:fos-transactions": "dotenv -e .env -- ts-node -r tsconfig-paths/register src/seed-fos-transactions.ts",
    "seed:fos-transactions:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod -- ts-node -r tsconfig-paths/register src/seed-fos-transactions.ts",
    "seed:fos-cashflows": "dotenv -e .env -- ts-node -r tsconfig-paths/register src/seed-fos-cashflows.ts",
    "seed:fos-cashflows:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod -- ts-node -r tsconfig-paths/register src/seed-fos-cashflows.ts",
    "verify:fos": "dotenv -e .env -- ts-node -r tsconfig-paths/register src/verify-fos-seed.ts",
    "verify:fos:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod -- ts-node -r tsconfig-paths/register src/verify-fos-seed.ts",
    "typeorm": "dotenv -e .env -- ts-node --project tsconfig.orm.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "typeorm:staging": "cross-env NODE_ENV=staging dotenv -e .env.staging -- ts-node --project tsconfig.orm.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "typeorm:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod -- ts-node --project tsconfig.orm.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:run:staging": "npm run typeorm:staging -- migration:run",
    "migration:run:prod": "npm run typeorm:prod -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:revert:staging": "npm run typeorm:staging -- migration:revert",
    "migration:revert:prod": "npm run typeorm:prod -- migration:revert",
    "seed:training": "dotenv -e .env -- ts-node -r tsconfig-paths/register src/seed-training.ts",
    "db:setup": "npm run migration:run && npm run seed && npm run seed:training",
    "db:reset": "dotenv -e .env -- ts-node --project tsconfig.orm.json -r tsconfig-paths/register src/database/reset-and-sync.ts",
    "db:reset:staging": "dotenv -e .env.staging -- ts-node --project tsconfig.orm.json -r tsconfig-paths/register src/database/reset-and-sync.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@infobip-api/sdk": "^0.3.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.17",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/nodemailer": "^7.0.9",
    "@types/socket.io": "^3.0.2",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.4",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "check-disk-space": "^3.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "google-auth-library": "^10.6.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "nodemailer": "^8.0.0",
    "openai": "^6.22.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.0",
    "typeorm": "^0.3.28",
    "uuid": "^11.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}